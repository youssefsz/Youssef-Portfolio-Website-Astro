---
import { TestimonialsMarquee } from "../ui/TestimonialsMarquee";
import type { Locale } from "../../i18n/content";
import { getTestimonials, siteContent } from "../../i18n/content";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const t = siteContent[locale];
const testimonials = getTestimonials(locale);
---

<section class="py-32 relative overflow-hidden" id="testimonials">
  <!-- Section Background -->
  <div class="pointer-events-none absolute inset-0 grid-bg opacity-30"></div>

  <div class="container-main relative z-10">
    <!-- Section Header - Centered -->
    <div class="text-center mb-20 flex flex-col items-center">
      <div>
        <div class="number-display mb-4">// 04</div>
      </div>

      <h2 id="testimonials-heading" tabindex="-1" class="display-lg mb-6">
        <div>
          <span class="block">{t.sections.testimonialsTop}</span>
          <span class="text-outline-hover">
            <span class="outline-text">{t.sections.testimonialsBottom}</span>
            <span class="filled-text" aria-hidden="true">{t.sections.testimonialsBottom}</span>
          </span>
        </div>
      </h2>

      <div>
        <p class="text-muted text-lg max-w-2xl mx-auto">
          {t.sections.testimonialsIntro}
        </p>
      </div>
    </div>

    <div>
      <TestimonialsMarquee client:visible testimonials={testimonials} labels={t.testimonialDialog} locale={locale} />
    </div>
  </div>
</section>
