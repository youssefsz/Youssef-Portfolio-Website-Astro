---
interface Props {
  variant?: "inline" | "badge";
}

const { variant = "inline" } = Astro.props;
---

<span class:list={["top-rated-plus", `top-rated-plus--${variant}`]}>
  {variant === "badge" && (
    <span class="top-rated-plus__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 28 28">
        <path
          fill="#F66DBC"
          d="M12 1.155a4 4 0 014 0l8.124 4.69a4 4 0 012 3.464v9.382a4 4 0 01-2 3.464L16 26.845a4 4 0 01-4 0l-8.124-4.69a4 4 0 01-2-3.464V9.309a4 4 0 012-3.464L12 1.155z"
        ></path>
        <path
          stroke="#fff"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-miterlimit="10"
          stroke-width="1.5"
          d="M17.94 18.396c.2.73-.597 1.262-1.195.863l-2.723-1.793-2.724 1.793c-.598.399-1.395-.199-1.196-.863l.731-3.122-2.524-2.06c-.598-.465-.266-1.395.465-1.46l3.255-.2 1.196-3.056c.265-.664 1.262-.664 1.527 0l1.196 3.056m1.662.199v4.65M20 14.078h-4.65"
        ></path>
      </svg>
    </span>
  )}

  <span class="top-rated-plus__effect">
    <span class="top-rated-plus__text">Top Rated Plus</span>
    <span class="top-rated-plus__sparkles" aria-hidden="true">
      <span class="top-rated-plus__sparkle top-rated-plus__sparkle--one"></span>
      <span class="top-rated-plus__sparkle top-rated-plus__sparkle--two"></span>
      <span class="top-rated-plus__sparkle top-rated-plus__sparkle--three"></span>
    </span>
  </span>
</span>

<style>
  .top-rated-plus {
    display: inline-flex;
    align-items: center;
    color: #f472b6;
    font-weight: 600;
    line-height: inherit;
    white-space: nowrap;
  }

  .top-rated-plus--inline {
    margin-inline: 0.08em;
    vertical-align: baseline;
  }

  .top-rated-plus--badge {
    gap: 0.5rem;
    width: fit-content;
    padding: 0.3rem 0.65rem 0.3rem 0.4rem;
    border: 1px solid rgba(246, 109, 188, 0.3);
    border-radius: 0.375rem;
    background: rgba(246, 109, 188, 0.07);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.025);
    font-size: 0.875rem;
    line-height: 1.25;
  }

  .top-rated-plus__icon {
    display: inline-flex;
    flex: 0 0 1.75rem;
    width: 1.75rem;
    height: 1.75rem;
  }

  .top-rated-plus__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .top-rated-plus__effect {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }

  .top-rated-plus__text {
    background-image: repeating-linear-gradient(
      90deg,
      #f472b6 0%,
      #fb7185 12%,
      #fff1f7 20%,
      #f0abfc 27%,
      #ec4899 38%,
      #f472b6 50%
    );
    background-position: 0% 50%;
    background-size: 200% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: top-rated-plus-shimmer 2.4s linear infinite;
  }

  .top-rated-plus__sparkles {
    position: absolute;
    inset: -0.24em -0.18em -0.12em;
    z-index: 1;
    pointer-events: none;
  }

  .top-rated-plus__sparkle {
    position: absolute;
    width: 0.32em;
    aspect-ratio: 1;
    background: #fbcfe8;
    clip-path: polygon(
      50% 0%,
      59% 38%,
      100% 50%,
      59% 62%,
      50% 100%,
      41% 62%,
      0% 50%,
      41% 38%
    );
    filter: drop-shadow(0 0 0.22em rgba(244, 114, 182, 0.75));
    opacity: 0.28;
    transform: scale(0.7) rotate(8deg);
    animation: top-rated-plus-twinkle 1.6s linear infinite;
  }

  .top-rated-plus__sparkle--one {
    top: 0;
    left: 10%;
    animation-delay: -0.15s;
  }

  .top-rated-plus__sparkle--two {
    top: 3%;
    right: 15%;
    width: 0.24em;
    animation-delay: -0.5s;
  }

  .top-rated-plus__sparkle--three {
    right: 1%;
    bottom: 1%;
    width: 0.2em;
    animation-delay: -0.85s;
  }

  @keyframes top-rated-plus-shimmer {
    from {
      background-position: 0% 50%;
    }

    to {
      background-position: 100% 50%;
    }
  }

  @keyframes top-rated-plus-twinkle {
    0% {
      opacity: 0.35;
      transform: scale(0.72) rotate(0deg);
    }

    25% {
      opacity: 0.95;
      transform: scale(1.08) rotate(90deg);
    }

    50% {
      opacity: 0.45;
      transform: scale(0.82) rotate(180deg);
    }

    75% {
      opacity: 0.9;
      transform: scale(1) rotate(270deg);
    }

    100% {
      opacity: 0.35;
      transform: scale(0.72) rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .top-rated-plus__text,
    .top-rated-plus__sparkle {
      animation: none;
    }

    .top-rated-plus__text {
      background-position: 50% 50%;
    }

    .top-rated-plus__sparkle {
      display: none;
    }
  }
</style>
