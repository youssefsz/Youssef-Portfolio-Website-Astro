---
import Logo from "./Logo.astro";
import LanguageToggle from "./LanguageToggle.astro";
import type { Locale } from "../../i18n/content";
import { siteContent } from "../../i18n/content";

interface Props { locale?: Locale; page?: "home" | "projects" }
const { locale = "en", page = "home" } = Astro.props;
const t = siteContent[locale];
const [home, projects] = t.nav;
const onHome = page === "home";
const pathKey = onHome ? "homePath" : "projectsPath";
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-black/80 backdrop-blur-md border-b border-white/5">
    <div class="nav-container container-main max-sm:px-3">
        <div class="flex h-20 items-center justify-between gap-2.5 max-[360px]:gap-0 md:grid md:grid-cols-[1fr_auto_1fr]">
            <a
                href={t.homePath}
                class="group inline-flex shrink-0 justify-self-start"
                aria-label={`YD — ${home}`}
            >
                <Logo />
            </a>

            <div class="flex items-center gap-4 sm:gap-7">
                <a
                    href={onHome ? "#home" : t.homePath}
                    class="nav-link link-hover text-sm uppercase font-medium sm:tracking-wider"
                    aria-current={onHome ? "page" : undefined}
                >
                    {home}
                </a>
                <a
                    href={t.projectsPath}
                    class="nav-link link-hover text-sm uppercase font-medium sm:tracking-wider"
                    aria-current={onHome ? undefined : "page"}
                >
                    {projects}
                </a>
            </div>

            <LanguageToggle
                locale={locale}
                englishPath={siteContent.en[pathKey]}
                frenchPath={siteContent.fr[pathKey]}
                class="shrink-0 justify-self-end"
            />
        </div>
    </div>
</nav>

<style>
    .nav-link {
        display: inline-grid;
        align-items: center;
        min-height: 2.75rem;
    }

    .nav-link::after {
        bottom: 0.375rem;
    }

    .nav-link[aria-current="page"] {
        color: var(--foreground);
    }

    .nav-link[aria-current="page"]::after {
        width: 100%;
    }

    @media (width < 48rem) {
        .nav-link {
            min-width: 2.75rem;
            min-height: 3rem;
            justify-items: center;
        }
    }

    @media (max-width: 360px) {
        .nav-container {
            padding-inline: clamp(0.25rem, calc((100vw - 18.5rem) / 4), 0.75rem);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-link,
        .nav-link::after {
            transition: none;
        }
    }
</style>
