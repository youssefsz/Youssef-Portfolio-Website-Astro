---
import { Image } from "astro:assets";
import ukFlag from "../assets/flags/united-kingdom.png";
import frFlag from "../assets/flags/france.png";
import type { Locale } from "../i18n/content";
import { siteContent } from "../i18n/content";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const t = siteContent[locale].resume;
---

<button type="button" class="btn-secondary group flex items-center gap-2" id="resume-dialog-trigger" aria-controls="resume-dialog" aria-expanded="false" aria-haspopup="dialog">
    <span>{t.button}</span>
</button>

<dialog id="resume-dialog" class="portfolio-dialog" aria-labelledby="resume-dialog-title" aria-describedby="resume-dialog-description">
    <div data-dialog-panel class="portfolio-dialog-panel max-w-md bg-black/90">
        <button type="button" autofocus data-dialog-close class="portfolio-dialog-close" aria-label={t.close}>
            <svg class="pointer-events-none h-5 w-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 6 12 12M6 18 18 6"></path>
            </svg>
        </button>
        <div class="pointer-events-none absolute left-0 top-0 h-3 w-3 border-l border-t border-accent"></div>
        <div class="pointer-events-none absolute right-0 top-0 h-3 w-3 border-r border-t border-accent"></div>
        <div class="pointer-events-none absolute bottom-0 left-0 h-3 w-3 border-b border-l border-accent"></div>
        <div class="pointer-events-none absolute bottom-0 right-0 h-3 w-3 border-b border-r border-accent"></div>

        <div class="min-h-0 overflow-y-auto overscroll-contain p-8" data-dialog-scroll>
            <h2 id="resume-dialog-title" class="mb-2 pr-6 font-display text-xl font-bold uppercase tracking-wide">
                {t.title}
            </h2>
            <p id="resume-dialog-description" class="mb-6 text-sm text-muted">
                {t.description}
            </p>

            <div class="space-y-3">
                <a
                    href="/resume/youssef-dhibi-cv-en.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group relative flex items-center overflow-hidden border border-white/10 bg-white/5 p-4 transition-all duration-300 hover:border-accent/50 hover:bg-white/10"
                >
                    <div class="absolute bottom-0 left-0 top-0 w-1 bg-accent opacity-0 transition-opacity group-hover:opacity-100"></div>
                    <div class="image-skeleton is-loading mr-5 h-8 w-12 shrink-0 rounded">
                        <Image
                            src={ukFlag}
                            alt={t.ukFlag}
                            width={48}
                            height={32}
                            class="h-full w-full rounded border border-white/10 object-cover shadow-sm"
                            loading="lazy"
                        />
                    </div>
                    <div class="flex-1">
                        <span class="block font-medium text-white">{t.english}</span>
                        <span class="text-xs text-muted">{t.format}</span>
                    </div>
                    <svg
                        class="h-5 w-5 text-muted opacity-50 transition-colors group-hover:text-accent group-hover:opacity-100"
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </a>

                <a
                    href="/resume/dhibi-youssef-cv-fr.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group relative flex items-center overflow-hidden border border-white/10 bg-white/5 p-4 transition-all duration-300 hover:border-accent/50 hover:bg-white/10"
                >
                    <div class="absolute bottom-0 left-0 top-0 w-1 bg-accent opacity-0 transition-opacity group-hover:opacity-100"></div>
                    <div class="image-skeleton is-loading mr-5 h-8 w-12 shrink-0 rounded">
                        <Image
                            src={frFlag}
                            alt={t.franceFlag}
                            width={48}
                            height={32}
                            class="h-full w-full rounded border border-white/10 object-cover shadow-sm"
                            loading="lazy"
                        />
                    </div>
                    <div class="flex-1">
                        <span class="block font-medium text-white">{t.french}</span>
                        <span class="text-xs text-muted">{t.format}</span>
                    </div>
                    <svg
                        class="h-5 w-5 text-muted opacity-50 transition-colors group-hover:text-accent group-hover:opacity-100"
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</dialog>

<script>
    import { createDialog } from "../lib/dialog";

    let cleanup: (() => void) | undefined;
    const initialize = () => {
        cleanup?.();
        const trigger = document.querySelector<HTMLButtonElement>("#resume-dialog-trigger");
        const element = document.querySelector<HTMLDialogElement>("#resume-dialog");
        if (!trigger || !element) return;
        const dialog = createDialog(element, {
            fallbackFocusId: "hero-cta-primary",
            onClose: () => trigger.setAttribute("aria-expanded", "false"),
        });
        const open = () => {
            dialog.open(trigger);
            trigger.setAttribute("aria-expanded", "true");
        };
        trigger.addEventListener("click", open);
        cleanup = () => {
            trigger.removeEventListener("click", open);
            dialog.destroy();
        };
    };
    document.addEventListener("astro:page-load", initialize);
    document.addEventListener("astro:before-swap", () => cleanup?.());
    initialize();
</script>
