---
import { Image } from "astro:assets";
import ukFlag from "../assets/flags/united-kingdom.png";
import frFlag from "../assets/flags/france.png";
---

<button
    type="button"
    class="btn-secondary group flex items-center gap-2"
    id="resume-dialog-trigger"
    aria-controls="resume-dialog"
    aria-expanded="false"
    aria-haspopup="dialog"
>
    <span>View My Resume</span>
</button>

<dialog
    id="resume-dialog"
    aria-labelledby="resume-dialog-title"
    aria-describedby="resume-dialog-description"
    class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none overflow-y-auto border-0 bg-transparent p-4 text-white"
>
    <div class="resume-dialog-layout">
        <div class="resume-dialog-panel relative w-full max-w-md overflow-hidden border border-white/10 bg-black/90">
            <div class="absolute left-0 top-0 h-3 w-3 border-l border-t border-accent"></div>
            <div class="absolute right-0 top-0 h-3 w-3 border-r border-t border-accent"></div>
            <div class="absolute bottom-0 left-0 h-3 w-3 border-b border-l border-accent"></div>
            <div class="absolute bottom-0 right-0 h-3 w-3 border-b border-r border-accent"></div>

            <form method="dialog">
                <button
                    type="submit"
                    class="absolute right-4 top-4 z-10 flex h-8 w-8 items-center justify-center text-muted transition-colors hover:text-white"
                    aria-label="Close resume dialog"
                    autofocus
                >
                    <svg
                        class="h-5 w-5"
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M18 6 6 18"></path>
                        <path d="m6 6 12 12"></path>
                    </svg>
                </button>
            </form>

            <div class="p-8">
                <h2 id="resume-dialog-title" class="mb-2 font-display text-xl font-bold uppercase tracking-wide">
                    Select Language
                </h2>
                <p id="resume-dialog-description" class="mb-6 text-sm text-muted">
                    Choose a version to view my resume.
                </p>

                <div class="space-y-3">
                    <a
                        href="/resume/youssef-dhibi-cv-en.pdf"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative flex items-center overflow-hidden border border-white/10 bg-white/5 p-4 transition-all duration-300 hover:border-accent/50 hover:bg-white/10"
                    >
                        <div class="absolute bottom-0 left-0 top-0 w-1 bg-accent opacity-0 transition-opacity group-hover:opacity-100"></div>
                        <div class="image-skeleton is-loading mr-5 h-8 w-12 shrink-0 rounded">
                            <Image
                                src={ukFlag}
                                alt="United Kingdom flag"
                                width={48}
                                height={32}
                                class="h-full w-full rounded border border-white/10 object-cover shadow-sm"
                                loading="lazy"
                            />
                        </div>
                        <div class="flex-1">
                            <span class="block font-medium text-white">English Version</span>
                            <span class="text-xs text-muted">PDF Format</span>
                        </div>
                        <svg
                            class="h-5 w-5 text-muted opacity-50 transition-colors group-hover:text-accent group-hover:opacity-100"
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </a>

                    <a
                        href="/resume/dhibi-youssef-cv-fr.pdf"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative flex items-center overflow-hidden border border-white/10 bg-white/5 p-4 transition-all duration-300 hover:border-accent/50 hover:bg-white/10"
                    >
                        <div class="absolute bottom-0 left-0 top-0 w-1 bg-accent opacity-0 transition-opacity group-hover:opacity-100"></div>
                        <div class="image-skeleton is-loading mr-5 h-8 w-12 shrink-0 rounded">
                            <Image
                                src={frFlag}
                                alt="France flag"
                                width={48}
                                height={32}
                                class="h-full w-full rounded border border-white/10 object-cover shadow-sm"
                                loading="lazy"
                            />
                        </div>
                        <div class="flex-1">
                            <span class="block font-medium text-white">French Version</span>
                            <span class="text-xs text-muted">PDF Format</span>
                        </div>
                        <svg
                            class="h-5 w-5 text-muted opacity-50 transition-colors group-hover:text-accent group-hover:opacity-100"
                            aria-hidden="true"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</dialog>

<script>
    let cleanupResumeDialog: (() => void) | undefined;

    const initializeResumeDialog = () => {
        cleanupResumeDialog?.();

        const trigger = document.querySelector<HTMLButtonElement>("#resume-dialog-trigger");
        const dialog = document.querySelector<HTMLDialogElement>("#resume-dialog");
        if (!trigger || !dialog) return;

        const controller = new AbortController();
        const { signal } = controller;
        let previousOverflow = "";

        const openDialog = () => {
            previousOverflow = document.body.style.overflow;
            trigger.setAttribute("aria-expanded", "true");
            document.body.style.overflow = "hidden";
            dialog.showModal();
        };

        const handleClose = () => {
            trigger.setAttribute("aria-expanded", "false");
            document.body.style.overflow = previousOverflow;
            trigger.focus();
        };

        trigger.addEventListener("click", openDialog, { signal });
        dialog.addEventListener("close", handleClose, { signal });
        dialog.addEventListener(
            "click",
            (event) => {
                if (event.target === dialog) dialog.close();
            },
            { signal },
        );

        cleanupResumeDialog = () => {
            controller.abort();
            if (dialog.open) dialog.close();
            document.body.style.overflow = previousOverflow;
        };
    };

    document.addEventListener("astro:page-load", initializeResumeDialog);
</script>

<style>
    #resume-dialog {
        opacity: 0;
        transition:
            opacity 200ms ease,
            display 200ms allow-discrete,
            overlay 200ms allow-discrete;
    }

    #resume-dialog[open] {
        display: block;
        opacity: 1;
    }

    #resume-dialog::backdrop {
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        opacity: 0;
        transition:
            opacity 200ms ease,
            display 200ms allow-discrete,
            overlay 200ms allow-discrete;
    }

    #resume-dialog[open]::backdrop {
        opacity: 1;
    }

    .resume-dialog-layout {
        display: flex;
        min-height: 100%;
        align-items: center;
        justify-content: center;
    }

    .resume-dialog-panel {
        animation: resume-dialog-enter 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes resume-dialog-enter {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.9);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @starting-style {
        #resume-dialog[open],
        #resume-dialog[open]::backdrop {
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #resume-dialog,
        #resume-dialog::backdrop {
            transition: none;
        }

        .resume-dialog-panel {
            animation: none;
        }
    }
</style>
