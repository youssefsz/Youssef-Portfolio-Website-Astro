---
import "../styles/global.css";
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import displayFont from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";
import profileImage from "../assets/profile/ysf.jpg";
import { profileLinks } from "../data/profile";
import type { Locale } from "../i18n/content";
import { siteContent } from "../i18n/content";
import NavigationProgress from "../components/layout/NavigationProgress.astro";
import ImageSkeletons from "../components/layout/ImageSkeletons.astro";
import ScrollRestoration from "../components/layout/ScrollRestoration.astro";

type Props =
    | { page: "home" | "projects"; locale: Locale }
    | { page: "error"; title: string; description: string };

const props = Astro.props;
const lang = props.page === "error" ? "en" : props.locale;
const t = siteContent[lang];
const metadata = props.page === "error" ? props : props.page === "projects" ? t.allProjects : t;
const { title, description } = metadata;
const socialTitle = props.page === "home" ? t.socialTitle : title;
const socialDescription = props.page === "home" ? t.socialDescription : description;

const siteUrl = new URL("/", Astro.site);
const route = props.page === "home" ? "homePath" : "projectsPath";
const localizedUrls = props.page === "error" ? null : {
    en: new URL(siteContent.en[route], siteUrl).href,
    fr: new URL(siteContent.fr[route], siteUrl).href,
};
const canonicalUrl = localizedUrls?.[lang];
const socialImage = new URL(lang === "fr" ? "/og-img-fr.png" : "/og-img.png", siteUrl).href;
const socialLocales = { en: "en_US", fr: "fr_FR" };
const alternateLang = lang === "en" ? "fr" : "en";

const personId = new URL("#person", siteUrl).href;
const websiteId = new URL("#website", siteUrl).href;
const portrait = canonicalUrl && await getImage({ src: profileImage, width: 500, height: 600 });
const structuredData = canonicalUrl && portrait && {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": websiteId,
            name: "Youssef Dhibi",
            url: siteUrl.href,
            inLanguage: ["en", "fr"],
            publisher: { "@id": personId },
        },
        {
            "@type": "Person",
            "@id": personId,
            name: "Youssef Dhibi",
            url: siteUrl.href,
            description: t.heroIntro,
            jobTitle: t.jobTitle,
            knowsLanguage: ["en", "fr", "ar"],
            address: {
                "@type": "PostalAddress",
                addressCountry: "TN",
            },
            image: new URL(portrait.src, siteUrl).href,
            sameAs: Object.values(profileLinks),
        },
        {
            "@type": props.page === "home" ? "ProfilePage" : "CollectionPage",
            "@id": `${canonicalUrl}#webpage`,
            url: canonicalUrl,
            name: title,
            description,
            inLanguage: lang,
            isPartOf: { "@id": websiteId },
            ...(props.page === "home"
                ? { mainEntity: { "@id": personId } }
                : { about: { "@id": personId } }),
        },
    ],
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/favicons/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicons/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicons/favicon-16x16.png"
        />
        <link rel="manifest" href="/favicons/site.webmanifest" />
        <link rel="shortcut icon" href="/favicons/favicon.ico" />

        {localizedUrls && (
            <>
                <link rel="canonical" href={canonicalUrl} />
                <link rel="alternate" hreflang="en" href={localizedUrls.en} />
                <link rel="alternate" hreflang="fr" href={localizedUrls.fr} />
                <link rel="alternate" hreflang="x-default" href={localizedUrls.en} />
            </>
        )}

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Youssef Dhibi" />
        <meta name="robots" content={canonicalUrl ? "max-image-preview:large" : "noindex"} />

        {canonicalUrl && (
            <>
                <meta property="og:type" content="website" />
                <meta property="og:url" content={canonicalUrl} />
                <meta property="og:title" content={socialTitle} />
                <meta property="og:description" content={socialDescription} />
                <meta property="og:site_name" content="Youssef Dhibi" />
                <meta property="og:locale" content={socialLocales[lang]} />
                <meta property="og:locale:alternate" content={socialLocales[alternateLang]} />
                <meta property="og:image" content={socialImage} />
                <meta property="og:image:width" content="1566" />
                <meta property="og:image:height" content="820" />
                <meta property="og:image:alt" content={t.socialImageAlt} />

                <meta name="twitter:card" content="summary_large_image" />
                <meta name="twitter:title" content={socialTitle} />
                <meta name="twitter:description" content={socialDescription} />
                <meta name="twitter:image" content={socialImage} />
                <meta name="twitter:image:alt" content={t.socialImageAlt} />
            </>
        )}

        <!-- Theme Color -->
        <meta name="theme-color" content="#000000" />

        <meta name="generator" content={Astro.generator} />

        <!-- Restore refresh position before revealing the document. -->
        <ScrollRestoration />

        <!-- Static pages with seamless client-side navigation and prefetching -->
        <ClientRouter />

        {structuredData && (
            <script
                type="application/ld+json"
                is:inline
                set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
            />
        )}

    </head>
    <body class="min-h-screen">
        <NavigationProgress />
        <ImageSkeletons />
        <slot />
        <script
  src="https://api.looksdone.app/looksdone.js"
  data-looksdone-project="pk_bDO0on5nv_67q-GnfxJOgw"
  defer
></script>
    </body>
</html>
