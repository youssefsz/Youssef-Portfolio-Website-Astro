---
import "../styles/global.css";
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import displayFont from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import { ClientRouter } from "astro:transitions";
import NavigationProgress from "../components/layout/NavigationProgress.astro";
import ImageSkeletons from "../components/layout/ImageSkeletons.astro";
import ScrollRestoration from "../components/layout/ScrollRestoration.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    lang?: "en" | "fr";
    alternatePath?: string;
    jobTitle?: string;
}

const {
    title = "Youssef Dhibi | Full-Stack Developer",
    description = "Youssef Dhibi is a full-stack developer in Tunisia building web, mobile, desktop, and CLI applications. Top Rated Plus on Upwork with 100% Job Success.",
    image = "/og-img.png",
    lang = "en",
    alternatePath,
    jobTitle = "Full-Stack Developer",
} = Astro.props;

const siteUrl = "https://youssef.tn";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const alternateLang = lang === "en" ? "fr" : "en";
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/favicons/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicons/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicons/favicon-16x16.png"
        />
        <link rel="manifest" href="/favicons/site.webmanifest" />
        <link rel="shortcut icon" href="/favicons/favicon.ico" />

        <!-- Canonical URL -->
        <link
            rel="canonical"
            href={canonicalUrl}
        />
        {alternatePath && <link rel="alternate" hreflang={lang} href={canonicalUrl} />}
        {alternatePath && <link rel="alternate" hreflang={alternateLang} href={new URL(alternatePath, siteUrl).href} />}
        {alternatePath && <link rel="alternate" hreflang="x-default" href={new URL(lang === "en" ? Astro.url.pathname : alternatePath, siteUrl).href} />}

        <!-- SEO Meta Tags -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Youssef Dhibi" />
        <meta name="robots" content="index, follow" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta
            property="og:url"
            content={canonicalUrl}
        />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content="Youssef Dhibi" />
        <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
        <meta property="og:image" content={new URL(image, siteUrl).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />

        <!-- Theme Color -->
        <meta name="theme-color" content="#000000" />

        <meta name="generator" content={Astro.generator} />

        <!-- Restore refresh position before revealing the document. -->
        <ScrollRestoration />

        <!-- Static pages with seamless client-side navigation and prefetching -->
        <ClientRouter />

        <!-- JSON-LD Structured Data -->
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "WebSite",
                        name: "Youssef Dhibi",
                        url: siteUrl,
                        description: description,
                        image: new URL(image, siteUrl).href,
                        inLanguage: lang,
                    },
                    {
                        "@type": "Person",
                        name: "Youssef Dhibi",
                        url: siteUrl,
                        jobTitle,
                        knowsLanguage: ["English", "French", "Arabic"],
                        address: {
                            "@type": "PostalAddress",
                            addressCountry: "TN",
                        },
                        knowsAbout: [
                            "Full-stack development",
                            "Web application development",
                            "Mobile application development",
                            "Desktop application development",
                            "Command-line tools",
                            "AI integrations",
                            "Flutter",
                            "SwiftUI",
                            "React",
                            "Astro",
                            "Node.js",
                            "Rust",
                        ],
                        image: new URL(image, siteUrl).href,
                        sameAs: [
                            "https://github.com/youssefsz",
                            "https://www.linkedin.com/in/youssefsz",
                            "https://www.facebook.com/youssefszz",
                            "https://apps.apple.com/us/developer/youssef-dhibi/id1855868676",
                            "https://pub.dev/publishers/youssef.tn/packages",
                            "https://www.upwork.com/freelancers/youssefsz",
                        ],
                    },
                ],
            })}
        />

    </head>
    <body class="min-h-screen">
        <NavigationProgress />
        <ImageSkeletons />
        <slot />
    </body>
</html>
